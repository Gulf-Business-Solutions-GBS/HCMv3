      ],
      "rules": "إلزامي. إحدى القيم: مشغول، غير مشغول.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> هل العهدة مسلَّمة لأحد حالياً.</p><p><strong>لماذا يهم.</strong> تُضبط يدوياً — فتسليم العهدة لموظف لا يغيّرها. وتظهر في تقرير العهد.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "Asset.EarningWageTypeId",
      "label": "Earning",
