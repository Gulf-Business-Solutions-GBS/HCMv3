      "aliases": [
        "loc:Earning",
        "dom:Asset_EarningWageTypeId"
      ],
      "rules": "اختياري. يُختار من قائمة أنواع الأجور.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> نوع أجر الاستحقاق المخصص لما يُصرف بخصوص هذه العهدة، مثل بدل يُصرف للموظف الذي يتسلّمها.</p><p><strong>مثال.</strong> بدل سيارة</p><p><strong>لماذا يهم.</strong> يُسجَّل فقط، ولا تقرؤه الرواتب حالياً.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "Asset.DeductionWageTypeId",
