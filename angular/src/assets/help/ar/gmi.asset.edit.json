      "aliases": [
        "loc:Status",
        "dom:Asset_Status"
      ],
      "rules": "إلزامي. إحدى القيم: مفعّل، غير مفعّل.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> هل العهدة قيد الاستخدام.</p><p><strong>لماذا يهم.</strong> لا تُعرض إلا العهد المفعّلة عندما يطلب الموظفون عهدة من خلال الخدمة الذاتية.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
