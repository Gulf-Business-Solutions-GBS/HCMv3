    {
      "id": "ManageSecuritySettings.EnableRowLevelSecurity",
      "label": "EnableRowLevelSecurity",
      "section": null,
      "aliases": [
        "loc:EnableRowLevelSecurity",
        "dom:SecuritySettings_EnableRowLevelSecurity"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان أمان مستوى السجلات مطبقاً.</p><p><strong>لماذا يهم.</strong> إذا أُشِّر عليه تقصر المواضع التي تطبّق أمان مستوى السجلات المستخدمين على الموظفين الذين تسمح بهم تعييناتهم الأمنية، ويُقيَّد مستلمو التقارير المجدولة بالطريقة نفسها. وإلا فلا يُطبَّق أي قيد على مستوى السجلات.</p>",
      "adminHtml": "",
      "stub": false
    },
