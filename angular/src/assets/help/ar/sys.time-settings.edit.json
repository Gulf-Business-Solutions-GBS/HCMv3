      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت البصمات تُستورد من قاعدة بيانات حضور MySQL.</p><p><strong>لماذا يهم.</strong> إذا أُشِّر عليه يعمل الاستيراد من MySQL، وإلا فلا يفعل شيئاً.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
