  "fields": [
    {
      "id": "ManageTimeSettings.EarliestEvaluationDate",
      "label": "EarliestEvaluationDate",
      "section": null,
      "aliases": [
        "loc:EarliestEvaluationDate",
        "dom:TimeSettings_EarliestEvaluationDate"
      ],
      "rules": "اختياري. تاريخ.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> أول تاريخ يحتسبه محرك الوقت.</p><p><strong>مثال.</strong> <code>2026-01-01</code></p><p><strong>لماذا يهم.</strong> لا يحتسب محرك الوقت الأيام السابقة له أبداً، وتبدأ منه عمليات استيراد الحضور إذا لم يُستورد شيء بعد، ويعامل نظام الرواتب تغييرات البيانات الأساسية المؤرخة قبله كأنها تمت فيه. اجعله تاريخ بدء التشغيل.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.FutureEvaluationInDays",
      "label": "FutureEvaluationInDays",
      "section": null,
      "aliases": [
        "loc:FutureEvaluationInDays",
        "dom:TimeSettings_FutureEvaluationInDays"
      ],
      "rules": "اختياري. رقم صحيح.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> عدد الأيام المقبلة التي يحتسبها محرك الوقت.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.RosterPlannerFrequency",
      "label": "RosterPlannerFrequency",
      "section": null,
      "aliases": [
        "loc:RosterPlannerFrequency",
        "dom:TimeSettings_RosterPlannerFrequency"
      ],
      "rules": "إلزامي. إحدى القيم: إسبوعي، شهري.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> عدد مرات تشغيل مخطط المناوبات.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableRosterDuty",
      "label": "EnableRosterDuty",
      "section": null,
      "aliases": [
        "loc:EnableRosterDuty",
        "dom:TimeSettings_EnableRosterDuty"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت الدوامات تأتي من المناوبات.</p><p><strong>لماذا يهم.</strong> إذا أُشِّر عليه يجد محرك الوقت ونظام الرواتب دوام كل يوم عبر ترتيب المناوبات — الدوام البديل، ثم فترة دوام الموظف مع دورتها، ثم مجموعة المناوبة. وإلا فيبقى الدوام البديل مقدَّماً، ثم تُستخدم دوامات أيام الأسبوع في فترة دوام الموظف، وتُتجاهل دورات الأسابيع ومجموعات المناوبة.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableTimeEngineAutorun",
      "label": "EnableTimeEngineAutorun",
      "section": null,
      "aliases": [
        "loc:EnableTimeEngineAutorun",
        "dom:TimeSettings_EnableTimeEngineAutorun"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان محرك الوقت يعمل تلقائياً.</p><p><strong>لماذا يهم.</strong> إذا أُشِّر عليه تشغّل مهمة خلفية محرك الوقت تلقائياً، ويتغير أسلوب تشغيل الرواتب في اختيار الموظفين وتواريخ التشغيل خارج الدورة (انظر تشغيل الرواتب). وإلا فلا يعمل محرك الوقت إلا عند تشغيله يدوياً.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableMiddleTierTimeEvents",
      "label": "EnableMiddleTierTimeEvents",
      "section": null,
      "aliases": [
        "loc:EnableMiddleTierTimeEvents",
        "dom:TimeSettings_EnableMiddleTierTimeEvents"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت البصمات تُؤخذ من قاعدة بيانات الحضور الوسيطة.</p><p><strong>لماذا يهم.</strong> إذا أُشِّر عليه تعمل مزامنة البصمات الوسيطة، وإلا فلا تفعل شيئاً.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableGeoFence",
      "label": "EnableGeoFence",
      "section": null,
      "aliases": [
        "loc:EnableGeoFence",
        "dom:TimeSettings_EnableGeoFence"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان يجب أن تكون بصمات الجوال ضمن نطاق موقع العمل.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableTimeAttendanceIntegration",
      "label": "EnableTimeAttendanceIntegration",
      "section": null,
      "aliases": [
        "loc:EnableTimeAttendanceIntegration",
        "dom:TimeSettings_EnableTimeAttendanceIntegration"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت البصمات تُستورد من أجهزة الحضور.</p><p><strong>لماذا يهم.</strong> إذا أُشِّر عليه يعمل الاستيراد من الأجهزة وإعادة السحب، وإلا فلا يفعلان شيئاً.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableAttendanceOnHoliday",
      "label": "EnableAttendanceOnHoliday",
      "section": null,
      "aliases": [
        "loc:EnableAttendanceOnHoliday",
        "dom:TimeSettings_EnableAttendanceOnHoliday"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان محرك الوقت يسجّل المواظبة تلقائياً.</p><p><strong>لماذا يهم.</strong> إذا أُشِّر عليه ينشئ محرك الوقت سجلات مواظبة الموظفين أو يحدّثها بنفسه أثناء معالجة كل يوم.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableAttendanceOnWeekOff",
      "label": "EnableAttendanceOnWeekOff",
      "section": null,
      "aliases": [
        "loc:EnableAttendanceOnWeekOff",
        "dom:TimeSettings_EnableAttendanceOnWeekOff"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت المواظبة تُسجَّل تلقائياً في أيام الراحة الأسبوعية.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableAttendanceOnRestDay",
      "label": "EnableAttendanceOnRestDay",
      "section": null,
      "aliases": [
        "loc:EnableAttendanceOnRestDay",
        "dom:TimeSettings_EnableAttendanceOnRestDay"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت المواظبة تُسجَّل تلقائياً في أيام الراحة.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.CountWeekoffOnPH",
      "label": "CountWeekoffOnPH",
      "section": null,
      "aliases": [
        "loc:CountWeekoffOnPH",
        "dom:TimeSettings_CountWeekoffOnPH"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت العطلة الرسمية الواقعة في راحة أسبوعية تُعدّ راحة أسبوعية.</p><p><strong>لماذا يهم.</strong> لا يمكن أن يكون اليوم الاثنين معاً. فإذا أُشِّر عليه يُعدّ راحة أسبوعية، وإلا فعطلة رسمية. وهذا يغيّر ما يصرفه نظام الرواتب عن اليوم.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.CountRestDayOnPH",
      "label": "CountRestDayOnPH",
      "section": null,
      "aliases": [
        "loc:CountRestDayOnPH",
        "dom:TimeSettings_CountRestDayOnPH"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت العطلة الرسمية الواقعة في يوم راحة تُعدّ يوم راحة.</p><p><strong>لماذا يهم.</strong> إذا أُشِّر عليه يُعدّ يوم راحة، وإلا فعطلة رسمية.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableTimeAttIntegrationAPI",
      "label": "EnableTimeAttIntegrationAPI",
      "section": null,
      "aliases": [
        "loc:EnableTimeAttIntegrationAPI",
        "dom:TimeSettings_EnableTimeAttIntegrationAPI"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت البصمات تُستورد من الواجهة البرمجية لنظام الحضور (BioTime).</p><p><strong>لماذا يهم.</strong> هو المفتاح نفسه في <strong>مركز التكامل ← BioTime</strong>.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.AllowDuplicateInTimeEvent",
      "label": "AllowDuplicateInTimeEvent",
      "section": null,
      "aliases": [
        "loc:AllowDuplicateInTimeEvent",
        "dom:TimeSettings_AllowDuplicateInTimeEvent"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان يجوز الاحتفاظ ببصمتين متطابقتين.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.UseActualTransInPlannedTimePolicy",
      "label": "UseActualTransInPlannedTimePolicy",
      "section": null,
      "aliases": [
        "loc:UseActualTransInPlannedTimePolicy",
        "dom:TimeSettings_UseActualTransInPlannedTimePolicy"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت بصمات موظفي الوقت المخطط تُقرأ رغم ذلك.</p><p><strong>لماذا يهم.</strong> إذا لم يُؤشَّر عليه يُعدّ موظفو سياسة <em>الوقت المخطط</em> قد عملوا المناوبة المخططة. وإذا أُشِّر عليه تُقرأ بصمات دخولهم وخروجهم أيضاً.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
