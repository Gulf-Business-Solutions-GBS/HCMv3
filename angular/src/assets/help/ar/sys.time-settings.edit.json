      ],
      "rules": "اختياري.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> المجلد الذي تُستورد منه ملفات البصمات.</p><p><strong>مثال.</strong> <code>D:\\Attendance\\Import</code></p><p><strong>لماذا يهم.</strong> يفحص الاستيراد من الملفات هذا المجلد بحثاً عن ملفات البصمات.</p>",
      "adminHtml": "",
      "stub": false
    },
