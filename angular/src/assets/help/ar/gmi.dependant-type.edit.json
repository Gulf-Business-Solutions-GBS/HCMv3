    {
      "id": "DependantType.IsEmployee",
      "label": "IsEmployee",
      "section": "DependantTypes",
      "aliases": [
        "loc:IsEmployee",
        "dom:DependantType_IsEmployee"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> يميّز الصفة التي تمثّل الموظف نفسه لا أحد أقاربه.</p><p><strong>لماذا يهم.</strong> يستخدمها استرداد المصاريف الصحية للتمييز بين حد الموظف نفسه وحدود عائليه. ولا يجوز تحديدها إلا لصفة عائل واحدة.</p>",
      "adminHtml": "",
      "stub": false
    }
