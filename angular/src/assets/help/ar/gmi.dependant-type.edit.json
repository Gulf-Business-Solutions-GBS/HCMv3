    {
      "id": "DependantType.Gender",
      "label": "Gender",
      "section": "DependantTypes",
      "aliases": [
        "loc:Gender",
        "dom:DependantType_Gender"
      ],
      "rules": "إلزامي. إحدى القيم: ذكر، أنثى.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> الجنس الذي تقتضيه صفة العائل — فالابن ذكر والابنة أنثى.</p><p><strong>لماذا يهم.</strong> يُسجَّل للعلم، ولا يطابق شيءٌ جنسَ العائل به.</p>",
      "adminHtml": "",
      "stub": false
