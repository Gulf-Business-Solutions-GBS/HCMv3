      "aliases": [
        "loc:MinEarnings",
        "dom:SocialSecurityDetail_MinEarnings"
      ],
      "rules": "اختياري. رقم.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> أدنى أجر في هذه الشريحة.</p><p><strong>مثال.</strong> <code>1501</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "SocialSecurityDetail.MaxEarnings",
      "label": "MaxEarnings",
      "section": "SocialSecurityDetails",
      "aliases": [
        "loc:MaxEarnings",
        "dom:SocialSecurityDetail_MaxEarnings"
      ],
      "rules": "اختياري. رقم.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> أعلى أجر في هذه الشريحة، ولا يجوز أن يقل عن الحد الأدنى.</p><p><strong>مثال.</strong> <code>2750</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "SocialSecurityDetail.EmployeeContribution",
      "label": "EmployeeContribution",
      "section": "SocialSecurityDetails",
      "aliases": [
        "loc:EmployeeContribution",
        "dom:SocialSecurityDetail_EmployeeContribution"
      ],
      "rules": "اختياري. رقم.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> نصيب الموظف، نسبةً مئوية من أجره.</p><p><strong>مثال.</strong> <code>2.5</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "SocialSecurityDetail.EmployerContribution",
      "label": "EmployerContribution",
      "section": "SocialSecurityDetails",
      "aliases": [
        "loc:EmployerContribution",
        "dom:SocialSecurityDetail_EmployerContribution"
      ],
      "rules": "اختياري. رقم.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> نصيب صاحب العمل، نسبةً مئوية من أجر الموظف.</p><p><strong>مثال.</strong> <code>11.5</code></p>",
      "adminHtml": "<p>لا يُحتسب نصيب صاحب العمل إلا إذا لم يكن اشتراك الموظف في الشريحة صفراً. ففي الشريحة التي يدفع فيها صاحب العمل وحده، أعطِ اشتراك الموظف قيمة وإلا كان نصيب صاحب العمل صفراً — وهذا سلوك النظام السابق وقد أُبقي عليه عمداً.</p>",
      "stub": false
    },
    {
      "id": "SocialSecurityDetail.MinEarningsEmployeeContribution",
      "label": "MinEarningsEmployeeContribution",
      "section": "SocialSecurityDetails",
      "aliases": [
        "loc:MinEarningsEmployeeContribution",
        "dom:SocialSecurityDetail_MinEarningsEmployeeContribution"
