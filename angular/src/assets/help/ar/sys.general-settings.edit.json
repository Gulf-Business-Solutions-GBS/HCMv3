    {
      "id": "ManageGeneralSettings.DateEditMask",
      "label": "DateEditMask",
      "section": null,
      "aliases": [
        "loc:DateEditMask",
        "dom:GeneralSettings_DateEditMask"
      ],
      "rules": "اختياري.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> تنسيق التاريخ المستخدم في رسائل البريد الإلكتروني والرسائل المولّدة.</p><p><strong>مثال.</strong> <code>dd/MM/yyyy</code></p><p><strong>لماذا يهم.</strong> إذا تُرك فارغاً يُستخدم <code>dd/MM/yyyy</code>. أما الشاشات فتستخدم تنسيق لغة المستخدم، لا هذا.</p>",
      "adminHtml": "",
      "stub": false
    },
