        "dom:ReportSettings_ShowSubordinatesPayslip"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان المديرون يستطيعون رؤية كشوف رواتب فرقهم.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
