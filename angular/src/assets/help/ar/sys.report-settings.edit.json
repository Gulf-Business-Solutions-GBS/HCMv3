      ],
      "rules": "اختياري. تاريخ.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> أقدم كشف راتب يستطيع الموظفون رؤيته.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
