      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت التقارير المصدَّرة تتضمن تذييلاً.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
