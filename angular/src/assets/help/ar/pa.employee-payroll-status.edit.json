      "aliases": [
        "loc:RunPayrollUpto",
        "dom:EmployeePayrollStatus_runPayrollUpto"
      ],
      "rules": "اختياري. تاريخ.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> تاريخ يجب أن تُشغَّل الرواتب حتى بلوغه.</p><p><strong>لماذا يهم.</strong> يُسجَّل فقط، ولا يقرؤه أي من المحركين حالياً.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "EmployeePayrollStatus.EarliestMasterDataChange",
