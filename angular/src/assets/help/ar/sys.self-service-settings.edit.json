  "fields": [
    {
      "id": "ManageSelfServiceSettings.RedirectAfterWFApproval",
      "label": "RedirectAfterWFApproval",
      "section": null,
      "aliases": [
        "loc:RedirectAfterWFApproval",
        "dom:SelfServiceSettings_RedirectAfterWFApproval"
      ],
      "rules": "إلزامي. إحدى القيم: افتراضي، ListView، لوحة القيادة.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> المكان الذي ينتقل إليه المستخدم بعد اعتماد طلب سير العمل.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.DefaultLoginPage",
      "label": "DefaultLoginPage",
      "section": null,
      "aliases": [
        "loc:DefaultLoginPage",
        "dom:SelfServiceSettings_DefaultLoginPage"
      ],
      "rules": "اختياري.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> الصفحة المعروضة بعد تسجيل دخول الموظف.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.CaptchaKey",
      "label": "CaptchaKey",
      "section": null,
      "aliases": [
        "loc:CaptchaKey",
        "dom:SelfServiceSettings_CaptchaKey"
      ],
      "rules": "اختياري.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> مفتاح رمز التحقق عند تسجيل الدخول.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.EmailNotification",
      "label": "EmailNotification",
      "section": null,
      "aliases": [
        "loc:EmailNotification",
        "dom:SelfServiceSettings_EmailNotification"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان النظام يرسل رسائل بريد إلكتروني.</p><p><strong>لماذا يهم.</strong> إذا لم يُؤشَّر عليه لا تُرسل الرسائل المرسلة عبر خدمة البريد في النظام — رسائل الإشعارات ورسائل البصمات.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.ShowEmployeeInfo",
      "label": "ShowEmployeeInfo",
      "section": null,
      "aliases": [
        "loc:ShowEmployeeInfo",
        "dom:SelfServiceSettings_ShowEmployeeInfo"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت معلومات الموظف تُعرض في الصفحة الرئيسية للخدمة الذاتية.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.IsAttachmentAllowed",
      "label": "IsAttachmentAllowed",
      "section": null,
      "aliases": [
        "loc:IsAttachmentAllowed",
        "dom:SelfServiceSettings_IsAttachmentAllowed"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان يمكن إضافة مرفقات إلى طلبات الخدمة الذاتية.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.AllowPunchOutsideRange",
      "label": "AllowPunchOutsideRange",
      "section": null,
      "aliases": [
        "loc:AllowPunchOutsideRange",
        "dom:SelfServiceSettings_AllowPunchOutsideRange"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت بصمات الجوال مسموحة خارج نطاق موقع العمل.</p><p><strong>لماذا يهم.</strong> تقرأه شاشة البصمة الجغرافية في الخدمة الذاتية. عند تفعيله يستطيع الموظف الذي يبعد عن موقع العمل أكثر من النطاق المسموح به أن يسجّل البصمة، وتُسجَّل البصمة على أنها خارج النطاق مع عدد الأمتار الزائدة عن النطاق. وعند إلغائه تُرفض هذه البصمة. ويقيس الخادم المسافة بنفسه.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.AutoLogoutAfterPunch",
      "label": "AutoLogoutAfterPunch",
      "section": null,
      "aliases": [
        "loc:AutoLogoutAfterPunch",
        "dom:SelfServiceSettings_AutoLogoutAfterPunch"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان المستخدم يُسجَّل خروجه بعد البصمة.</p><p><strong>لماذا يهم.</strong> تقرأه شاشة البصمة الجغرافية في الخدمة الذاتية: عند تفعيله يُسجَّل خروج الموظف من النظام مباشرة بعد تسجيل البصمة بنجاح.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.AllowGeolocationSelfie",
      "label": "AllowGeolocationSelfie",
      "section": null,
      "aliases": [
        "loc:AllowGeolocationSelfie",
        "dom:SelfServiceSettings_AllowGeolocationSelfie"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت تُلتقط صورة ذاتية مع بصمة الجوال.</p><p><strong>لماذا يهم.</strong> تقرأه شاشة البصمة الجغرافية في الخدمة الذاتية. عند تفعيله، وكانت سياسة الدوام الخاصة بالموظف تتطلب التعرف على الوجه (ويُعامل الموظف الذي ليست له سياسة دوام على أنها مفعّلة)، يجب التقاط صورة شخصية مع كل بصمة جغرافية. وتُحفظ الصورة مع البصمة، ويمكن للموارد البشرية عرضها من شاشة أحداث الدوام.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.HideGeolocationInfo",
      "label": "HideGeolocationInfo",
      "section": null,
      "aliases": [
        "loc:HideGeolocationInfo",
        "dom:SelfServiceSettings_HideGeolocationInfo"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت تفاصيل الموقع مخفية.</p><p><strong>لماذا يهم.</strong> تقرأه شاشة البصمة الجغرافية في الخدمة الذاتية: عند تفعيله تُخفى اللوحة التي تعرض إحداثيات الموظف وموقع العمل والنطاق المسموح به والمسافة. ويبقى التحقق من النطاق مطبقاً.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.HideGeolocationPunchInfo",
      "label": "HideGeolocationPunchInfo",
      "section": null,
      "aliases": [
        "loc:HideGeolocationPunchInfo",
        "dom:SelfServiceSettings_HideGeolocationPunchInfo"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت تفاصيل موقع البصمات مخفية.</p><p><strong>لماذا يهم.</strong> تقرأه شاشة البصمة الجغرافية في الخدمة الذاتية: عند تفعيله تُخفى قائمة بصمات اليوم في تلك الشاشة.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.ShowLeaveInfo",
      "label": "ShowLeaveInfo",
      "section": null,
      "aliases": [
        "loc:ShowLeaveInfo",
        "dom:SelfServiceSettings_ShowLeaveInfo"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كانت معلومات الإجازات معروضة.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.ShowCurrentLeaveBalance",
      "label": "ShowCurrentLeaveBalance",
      "section": null,
      "aliases": [
        "loc:ShowCurrentLeaveBalance",
        "dom:SelfServiceSettings_ShowCurrentLeaveBalance"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان رصيد الإجازة الحالي معروضاً.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.ShowUpdatedLeaveBalance",
      "label": "ShowUpdatedLeaveBalance",
      "section": null,
      "aliases": [
        "loc:ShowUpdatedLeaveBalance",
        "dom:SelfServiceSettings_ShowUpdatedLeaveBalance"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان رصيد الإجازة بعد الطلب معروضاً.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.IsAdditionalUnpaidLeaveAllowed",
      "label": "IsAdditionalUnpaidLeaveAllowed",
      "section": null,
      "aliases": [
        "loc:IsAdditionalUnpaidLeaveAllowed",
        "dom:SelfServiceSettings_IsAdditionalUnpaidLeaveAllowed"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان يمكن طلب إجازة غير مدفوعة إضافية.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.ShowPaymentDate",
      "label": "ShowPaymentDate",
      "section": null,
      "aliases": [
        "loc:ShowPaymentDate",
        "dom:SelfServiceSettings_ShowPaymentDate"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان تاريخ دفع الإجازة معروضاً.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.EnablePayWithPayroll",
      "label": "EnablePayWithPayroll",
      "section": null,
      "aliases": [
        "loc:EnablePayWithPayroll",
        "dom:SelfServiceSettings_EnablePayWithPayroll"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان يمكن للموظفين اختيار الصرف مع الرواتب.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.EnablePayInAdvance",
      "label": "EnablePayInAdvance",
      "section": null,
      "aliases": [
        "loc:EnablePayInAdvance",
        "dom:SelfServiceSettings_EnablePayInAdvance"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان يمكن للموظفين اختيار الصرف مقدماً.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.IsPassportWithdrawalRequired",
      "label": "IsPassportWithdrawalRequired",
      "section": null,
      "aliases": [
        "loc:IsPassportWithdrawalRequired",
        "dom:SelfServiceSettings_IsPassportWithdrawalRequired"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان سحب جواز السفر مطلوباً مع الإجازة.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.PassportWithdrawalSubmissionStep",
      "label": "PassportWithdrawalSubmissionStep",
      "section": null,
      "aliases": [
        "loc:PassportWithdrawalSubmissionStep",
        "dom:SelfServiceSettings_PassportWithdrawalSubmissionStep"
      ],
      "rules": "اختياري. رقم صحيح.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> خطوة سير العمل التي يُقدَّم فيها سحب جواز السفر.</p><p><strong>لماذا يهم.</strong> لا يُقرأ حالياً — تغييره لا أثر له.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.IsWithdrawalReasonMandatory",
      "label": "IsWithdrawalReasonMandatory",
      "section": null,
      "aliases": [
        "loc:IsWithdrawalReasonMandatory",
        "dom:SelfServiceSettings_IsWithdrawalReasonMandatory"
      ],
      "rules": "نعم أو لا.",
      "when": null,
      "html": "<p><strong>ما هو.</strong> ما إذا كان يجب على الموظف ذكر سبب عند طلب سحب مستند مثل جواز السفر.</p><p><strong>لماذا يهم.</strong> إذا أُشِّر عليه، يُرفض طلب سحب المستند عبر الخدمة الذاتية إذا لم يتضمن سبباً. وإلى أن تُحفظ الإعدادات أول مرة يكون السبب اختيارياً.</p>",
      "adminHtml": "",
      "stub": false
    }
  ]
