    "loc:InstallmentAmount": "CompanyInsuranceDetail.InstallmentAmount",
    "dom:CompanyInsuranceDetail_InstallmentAmount": "CompanyInsuranceDetail.InstallmentAmount",
    "loc:InstallmentType": "CompanyInsuranceDetail.InstallmentType",
