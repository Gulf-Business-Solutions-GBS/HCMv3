        "dom:EmployeeDependantException_ExceptionBenefitType"
      ],
      "rules": "Required. One of: Ticket, Health Reimbursement.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Which benefit is overridden.</p><p><strong>Example.</strong> Ticket</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "EmployeeDependantException.StartDate",
      "label": "StartDate",
      "section": "EmployeeDependantExceptions",
      "aliases": [
