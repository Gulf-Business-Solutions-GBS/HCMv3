    "dom:EmployeeDependantException_EmployeeDependantId": "EmployeeDependantException.EmployeeDependantId",
    "loc:ExceptionBenefitType": "EmployeeDependantException.ExceptionBenefitType",
    "dom:EmployeeDependantException_ExceptionBenefitType": "EmployeeDependantException.ExceptionBenefitType",
    "loc:StartDate": "EmployeeDependantException.StartDate",
    "dom:EmployeeDependantException_StartDate": "EmployeeDependantException.StartDate",
    "loc:EndDate": "EmployeeDependantException.EndDate",
    "dom:EmployeeDependantException_EndDate": "EmployeeDependantException.EndDate",
    "loc:Amount": "EmployeeDependantException.Amount",
    "dom:EmployeeDependantException_Amount": "EmployeeDependantException.Amount"
  },
  "fields": [
    {
