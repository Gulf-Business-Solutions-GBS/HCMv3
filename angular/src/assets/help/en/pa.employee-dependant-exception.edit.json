      ],
      "rules": "Required. Chosen from a list.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The dependant the exception applies to.</p><p><strong>Example.</strong> Sara Al-Mutairi (Daughter)</p>",
      "adminHtml": "",
      "stub": false
    },
