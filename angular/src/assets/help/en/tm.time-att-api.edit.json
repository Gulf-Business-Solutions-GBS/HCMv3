    "dom:TimeAttAPI_Email": "TimeAttAPI.Email",
    "loc:Company": "TimeAttAPI.Company",
    "dom:TimeAttAPI_Company": "TimeAttAPI.Company",
    "loc:PunchInCode": "TimeAttAPI.PunchInCode",
    "dom:TimeAttAPI_PunchInCode": "TimeAttAPI.PunchInCode",
    "loc:PunchOutCode": "TimeAttAPI.PunchOutCode",
