  "fields": [
    {
      "id": "TimeAttAPI.TokenUrl",
      "label": "TokenUrl",
      "section": "TimeAttAPIs",
      "aliases": [
        "loc:TokenUrl",
        "dom:TimeAttAPI_TokenUrl"
      ],
      "rules": "Required. Maximum 500 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The address used to sign in to the attendance system.</p><p><strong>Example.</strong> <code>https://biotime.example.com/jwt-api-token-auth/</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "TimeAttAPI.TransactionsUrl",
      "label": "TransactionsUrl",
      "section": "TimeAttAPIs",
      "aliases": [
        "loc:TransactionsUrl",
        "dom:TimeAttAPI_TransactionsUrl"
      ],
      "rules": "Required. Maximum 500 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The address punches are read from.</p><p><strong>Example.</strong> <code>https://biotime.example.com/iclock/api/transactions/</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "TimeAttAPI.DevicesUrl",
      "label": "DevicesUrl",
      "section": "TimeAttAPIs",
      "aliases": [
        "loc:DevicesUrl",
        "dom:TimeAttAPI_DevicesUrl"
      ],
      "rules": "Required. Maximum 500 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The address the list of devices is read from.</p><p><strong>Example.</strong> <code>https://biotime.example.com/iclock/api/terminals/</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "TimeAttAPI.Username",
      "label": "Username",
      "section": "TimeAttAPIs",
      "aliases": [
        "loc:Username",
        "dom:TimeAttAPI_Username"
      ],
      "rules": "Required. Maximum 256 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The account used to sign in to the attendance system.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "TimeAttAPI.Password",
      "label": "Password",
      "section": "TimeAttAPIs",
      "aliases": [
        "loc:Password",
        "dom:TimeAttAPI_Password"
      ],
      "rules": "Required when you create the record. Maximum 128 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The password for that account. When you edit, the field is empty because the saved password is never shown; leave it blank to keep it, or type a new one to replace it.</p>",
      "adminHtml": "<p>The password is stored encrypted, whether it is saved from this form or from Integration Center. A password saved before encryption was introduced still works and is encrypted the next time the record is saved.</p>",
      "stub": false
    },
    {
      "id": "TimeAttAPI.NoOfRecords",
      "label": "NoOfRecords",
      "section": "TimeAttAPIs",
      "aliases": [
        "loc:NoOfRecords",
        "dom:TimeAttAPI_NoOfRecords"
      ],
      "rules": "Required. Whole number.",
      "when": null,
      "html": "<p><strong>What it is.</strong> How many punches are read per request.</p><p><strong>Example.</strong> <code>500</code></p><p><strong>Why it matters.</strong> The import keeps requesting pages of this size until a page comes back short.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "TimeAttAPI.Email",
      "label": "Email",
      "section": "TimeAttAPIs",
      "aliases": [
        "loc:Email",
        "dom:TimeAttAPI_Email"
      ],
      "rules": "Optional. Maximum 256 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> A contact email for the connection.</p><p><strong>Why it matters.</strong> Not read at present.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "TimeAttAPI.Company",
      "label": "Company",
      "section": "TimeAttAPIs",
      "aliases": [
        "loc:Company",
        "dom:TimeAttAPI_Company"
      ],
      "rules": "Optional. Maximum 256 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The company name in the attendance system.</p><p><strong>Why it matters.</strong> Not read at present.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "TimeAttAPI.PunchInCode",
      "label": "PunchInCode",
      "section": "TimeAttAPIs",
      "aliases": [
        "loc:PunchInCode",
        "dom:TimeAttAPI_PunchInCode"
      ],
      "rules": "Optional. Maximum 50 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The attendance-system punch states that mean clock in, separated by commas.</p><p><strong>Example.</strong> <code>0</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "TimeAttAPI.PunchOutCode",
      "label": "PunchOutCode",
      "section": "TimeAttAPIs",
      "aliases": [
        "loc:PunchOutCode",
        "dom:TimeAttAPI_PunchOutCode"
      ],
      "rules": "Optional. Maximum 50 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The punch states that mean clock out.</p><p><strong>Example.</strong> <code>1</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "TimeAttAPI.BreakOutCode",
      "label": "BreakOutCode",
      "section": "TimeAttAPIs",
      "aliases": [
        "loc:BreakOutCode",
        "dom:TimeAttAPI_BreakOutCode"
      ],
      "rules": "Optional. Maximum 50 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The punch states that mean out for a break.</p><p><strong>Example.</strong> <code>2</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "TimeAttAPI.BreakInCode",
      "label": "BreakInCode",
      "section": "TimeAttAPIs",
      "aliases": [
        "loc:BreakInCode",
        "dom:TimeAttAPI_BreakInCode"
      ],
      "rules": "Optional. Maximum 50 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The punch states that mean back from a break.</p><p><strong>Example.</strong> <code>3</code></p>",
      "adminHtml": "",
