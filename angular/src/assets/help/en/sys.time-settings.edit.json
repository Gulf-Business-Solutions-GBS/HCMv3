        "dom:TimeSettings_HourlyLeaveShouldSignIn"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether the employee must punch in after hourly leave at the start of the shift.</p><p><strong>Why it matters.</strong> Used with hourly leave logic.</p>",
      "adminHtml": "",
      "stub": false
    },
