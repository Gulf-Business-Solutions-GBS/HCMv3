    {
      "id": "ManageTimeSettings.ExcludePaidLeaveAccrualOnAbsent",
      "label": "ExcludePaidLeaveAccrualOnAbsent",
      "section": null,
      "aliases": [
        "loc:ExcludePaidLeaveAccrualOnAbsent",
        "dom:TimeSettings_ExcludePaidLeaveAccrualOnAbsent"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether absent days earn no annual leave.</p><p><strong>Why it matters.</strong> Ticked, the time engine accrues no annual leave for a day the employee was absent.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.HourlyLeavelogicEnable",
      "label": "HourlyLeavelogicEnable",
      "section": null,
      "aliases": [
        "loc:HourlyLeavelogicEnable",
        "dom:TimeSettings_HourlyLeavelogicEnable"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether hourly leave at the start or end of the shift moves the expected punch.</p><p><strong>Why it matters.</strong> Ticked, for actual-time employees the time engine takes hourly leave into account when reading the clock-in and clock-out, so leaving early or arriving late on leave is not counted as lateness.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
