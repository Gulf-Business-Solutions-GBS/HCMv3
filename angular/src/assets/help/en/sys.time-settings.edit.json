  "fields": [
    {
      "id": "ManageTimeSettings.EarliestEvaluationDate",
      "label": "EarliestEvaluationDate",
      "section": null,
      "aliases": [
        "loc:EarliestEvaluationDate",
        "dom:TimeSettings_EarliestEvaluationDate"
      ],
      "rules": "Optional. Date value.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The first date the time engine evaluates.</p><p><strong>Example.</strong> <code>2026-01-01</code></p><p><strong>Why it matters.</strong> The time engine never works out days before it, attendance imports start from it when nothing has been imported yet, and payroll treats master-data changes dated earlier as if made on it. Set it to the go-live date.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.FutureEvaluationInDays",
      "label": "FutureEvaluationInDays",
      "section": null,
      "aliases": [
        "loc:FutureEvaluationInDays",
        "dom:TimeSettings_FutureEvaluationInDays"
      ],
      "rules": "Optional. Whole number.",
      "when": null,
      "html": "<p><strong>What it is.</strong> How many days ahead the time engine evaluates.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.RosterPlannerFrequency",
      "label": "RosterPlannerFrequency",
      "section": null,
      "aliases": [
        "loc:RosterPlannerFrequency",
        "dom:TimeSettings_RosterPlannerFrequency"
      ],
      "rules": "Required. One of: Weekly, Monthly.",
      "when": null,
      "html": "<p><strong>What it is.</strong> How often the roster planner runs.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableRosterDuty",
      "label": "EnableRosterDuty",
      "section": null,
      "aliases": [
        "loc:EnableRosterDuty",
        "dom:TimeSettings_EnableRosterDuty"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether duties come from rosters.</p><p><strong>Why it matters.</strong> Ticked, the time engine and payroll find each day's duty through the roster order — substitute duty, the employee's duty period with its rotation, then the roster group. Unticked, a substitute duty still wins, otherwise the weekday duties of the employee's own duty period are used; week rotations and roster groups are ignored.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableTimeEngineAutorun",
      "label": "EnableTimeEngineAutorun",
      "section": null,
      "aliases": [
        "loc:EnableTimeEngineAutorun",
        "dom:TimeSettings_EnableTimeEngineAutorun"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether the time engine runs automatically.</p><p><strong>Why it matters.</strong> Ticked, a background job runs the time engine on its own, and payroll runs change how they pick employees and off-cycle dates (see Run Payroll). Unticked, the time engine runs only when started by hand.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableMiddleTierTimeEvents",
      "label": "EnableMiddleTierTimeEvents",
      "section": null,
      "aliases": [
        "loc:EnableMiddleTierTimeEvents",
        "dom:TimeSettings_EnableMiddleTierTimeEvents"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether punches are taken from the middle-tier attendance database.</p><p><strong>Why it matters.</strong> Ticked, the middle-tier punch sync runs; unticked, it does nothing.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableGeoFence",
      "label": "EnableGeoFence",
      "section": null,
      "aliases": [
        "loc:EnableGeoFence",
        "dom:TimeSettings_EnableGeoFence"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether mobile punches must be within the work location's range.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableTimeAttendanceIntegration",
      "label": "EnableTimeAttendanceIntegration",
      "section": null,
      "aliases": [
        "loc:EnableTimeAttendanceIntegration",
        "dom:TimeSettings_EnableTimeAttendanceIntegration"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether punches are imported from attendance devices.</p><p><strong>Why it matters.</strong> Ticked, the device import and re-pull run; unticked, they do nothing.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableAttendanceOnHoliday",
      "label": "EnableAttendanceOnHoliday",
      "section": null,
      "aliases": [
        "loc:EnableAttendanceOnHoliday",
        "dom:TimeSettings_EnableAttendanceOnHoliday"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether the time engine records attendance automatically.</p><p><strong>Why it matters.</strong> Ticked, the time engine creates or updates employee attendance records itself as it processes each day.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableAttendanceOnWeekOff",
      "label": "EnableAttendanceOnWeekOff",
      "section": null,
      "aliases": [
        "loc:EnableAttendanceOnWeekOff",
        "dom:TimeSettings_EnableAttendanceOnWeekOff"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether attendance is recorded automatically on weekly offs.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableAttendanceOnRestDay",
      "label": "EnableAttendanceOnRestDay",
      "section": null,
      "aliases": [
        "loc:EnableAttendanceOnRestDay",
        "dom:TimeSettings_EnableAttendanceOnRestDay"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether attendance is recorded automatically on rest days.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.CountWeekoffOnPH",
      "label": "CountWeekoffOnPH",
      "section": null,
      "aliases": [
        "loc:CountWeekoffOnPH",
        "dom:TimeSettings_CountWeekoffOnPH"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether a public holiday on a weekly off counts as the weekly off.</p><p><strong>Why it matters.</strong> A day cannot be both. Ticked, it counts as a weekly off; unticked, as a public holiday. This changes what payroll pays for the day.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.CountRestDayOnPH",
      "label": "CountRestDayOnPH",
      "section": null,
      "aliases": [
        "loc:CountRestDayOnPH",
        "dom:TimeSettings_CountRestDayOnPH"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether a public holiday on a rest day counts as the rest day.</p><p><strong>Why it matters.</strong> Ticked, it counts as a rest day; unticked, as a public holiday.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.EnableTimeAttIntegrationAPI",
      "label": "EnableTimeAttIntegrationAPI",
      "section": null,
      "aliases": [
        "loc:EnableTimeAttIntegrationAPI",
        "dom:TimeSettings_EnableTimeAttIntegrationAPI"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether punches are imported from the attendance system's API (BioTime).</p><p><strong>Why it matters.</strong> The same switch as <strong>Integration Center → BioTime</strong>.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.AllowDuplicateInTimeEvent",
      "label": "AllowDuplicateInTimeEvent",
      "section": null,
      "aliases": [
        "loc:AllowDuplicateInTimeEvent",
        "dom:TimeSettings_AllowDuplicateInTimeEvent"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether two identical punches may be kept.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageTimeSettings.UseActualTransInPlannedTimePolicy",
      "label": "UseActualTransInPlannedTimePolicy",
      "section": null,
      "aliases": [
        "loc:UseActualTransInPlannedTimePolicy",
        "dom:TimeSettings_UseActualTransInPlannedTimePolicy"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether planned-time employees still have their punches read.</p><p><strong>Why it matters.</strong> Unticked, employees on a <em>Planned Time</em> policy are taken to have worked the planned shift. Ticked, their clock-in and clock-out punches are read too.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
