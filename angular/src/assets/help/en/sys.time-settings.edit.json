      "label": "EnableMySqlIntegration",
      "section": null,
      "aliases": [
        "loc:EnableMySqlIntegration",
        "dom:TimeSettings_EnableMySqlIntegration"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether punches are imported from a MySQL attendance database.</p><p><strong>Why it matters.</strong> Ticked, the MySQL import runs; unticked, it does nothing.</p>",
