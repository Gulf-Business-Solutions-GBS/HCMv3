  "fields": [
    {
      "id": "ManageSelfServiceSettings.RedirectAfterWFApproval",
      "label": "RedirectAfterWFApproval",
      "section": null,
      "aliases": [
        "loc:RedirectAfterWFApproval",
        "dom:SelfServiceSettings_RedirectAfterWFApproval"
      ],
      "rules": "Required. One of: Default, ListView, Dashboard.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Where the user goes after approving a workflow request.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.DefaultLoginPage",
      "label": "DefaultLoginPage",
      "section": null,
      "aliases": [
        "loc:DefaultLoginPage",
        "dom:SelfServiceSettings_DefaultLoginPage"
      ],
      "rules": "Optional.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The page shown after an employee signs in.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.CaptchaKey",
      "label": "CaptchaKey",
      "section": null,
      "aliases": [
        "loc:CaptchaKey",
        "dom:SelfServiceSettings_CaptchaKey"
      ],
      "rules": "Optional.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The key for the sign-in captcha.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.EmailNotification",
      "label": "EmailNotification",
      "section": null,
      "aliases": [
        "loc:EmailNotification",
        "dom:SelfServiceSettings_EmailNotification"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether the system sends emails.</p><p><strong>Why it matters.</strong> Unticked, emails sent through the system's email service — notification emails and punch emails — are not sent.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.ShowEmployeeInfo",
      "label": "ShowEmployeeInfo",
      "section": null,
      "aliases": [
        "loc:ShowEmployeeInfo",
        "dom:SelfServiceSettings_ShowEmployeeInfo"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether employee information is shown on the self-service home page.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.IsAttachmentAllowed",
      "label": "IsAttachmentAllowed",
      "section": null,
      "aliases": [
        "loc:IsAttachmentAllowed",
        "dom:SelfServiceSettings_IsAttachmentAllowed"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether attachments can be added to self-service requests.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.AllowPunchOutsideRange",
      "label": "AllowPunchOutsideRange",
      "section": null,
      "aliases": [
        "loc:AllowPunchOutsideRange",
        "dom:SelfServiceSettings_AllowPunchOutsideRange"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether mobile punches are allowed outside the work location range.</p><p><strong>Why it matters.</strong> Read by the self-service Geo Punch screen. When it is on, an employee who is further from the work location than its allowed range can still punch; the punch is recorded as out of range, with how many metres beyond the range it was. When it is off, such a punch is refused. The server measures the distance itself.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.AutoLogoutAfterPunch",
      "label": "AutoLogoutAfterPunch",
      "section": null,
      "aliases": [
        "loc:AutoLogoutAfterPunch",
        "dom:SelfServiceSettings_AutoLogoutAfterPunch"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether the user is signed out after punching.</p><p><strong>Why it matters.</strong> Read by the self-service Geo Punch screen: when it is on, the employee is signed out straight after a successful punch.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.AllowGeolocationSelfie",
      "label": "AllowGeolocationSelfie",
      "section": null,
      "aliases": [
        "loc:AllowGeolocationSelfie",
        "dom:SelfServiceSettings_AllowGeolocationSelfie"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether a selfie is taken with a mobile punch.</p><p><strong>Why it matters.</strong> Read by the self-service Geo Punch screen. When it is on, and the employee's time policy has Is Face Required on (an employee with no time policy counts as on), a selfie must be taken with every geo punch. The selfie is kept with the punch and HR can view it from Time Events.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.HideGeolocationInfo",
      "label": "HideGeolocationInfo",
      "section": null,
      "aliases": [
        "loc:HideGeolocationInfo",
        "dom:SelfServiceSettings_HideGeolocationInfo"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether location details are hidden.</p><p><strong>Why it matters.</strong> Read by the self-service Geo Punch screen: when it is on, the panel showing the employee's coordinates, the work location, the allowed range and the distance is hidden. The range check still applies.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.HideGeolocationPunchInfo",
      "label": "HideGeolocationPunchInfo",
      "section": null,
      "aliases": [
        "loc:HideGeolocationPunchInfo",
        "dom:SelfServiceSettings_HideGeolocationPunchInfo"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether location details of punches are hidden.</p><p><strong>Why it matters.</strong> Read by the self-service Geo Punch screen: when it is on, the list of today's punches is hidden on that screen.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "ManageSelfServiceSettings.ShowLeaveInfo",
      "label": "ShowLeaveInfo",
      "section": null,
      "aliases": [
        "loc:ShowLeaveInfo",
        "dom:SelfServiceSettings_ShowLeaveInfo"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether leave information is shown.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
