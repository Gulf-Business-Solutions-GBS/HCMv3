        "dom:EmployeeRemuneration_PaymentDate"
      ],
      "rules": "Required. Date value.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The date the days or hours belong to.</p><p><strong>Example.</strong> 15 Sep 2026</p><p><strong>Why it matters.</strong> Entries dated in the payroll month are counted.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "EmployeeRemuneration.PaymentNumber",
