    "loc:PaymentNumber": "EmployeeRemuneration.PaymentNumber",
    "dom:EmployeeRemuneration_PaymentNumber": "EmployeeRemuneration.PaymentNumber",
    "loc:PaymentUnit": "EmployeeRemuneration.PaymentUnit",
    "dom:EmployeeRemuneration_PaymentUnit": "EmployeeRemuneration.PaymentUnit",
