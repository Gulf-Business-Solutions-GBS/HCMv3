      ],
      "rules": "Required. Number.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The number of days or hours.</p><p><strong>Example.</strong> 22</p><p><strong>Why it matters.</strong> Cannot be zero. Hours are converted to days using the employee's hours for the day.</p>",
      "adminHtml": "",
      "stub": false
    },
