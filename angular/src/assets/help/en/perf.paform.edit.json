      "id": "PAForm.OverallScore",
      "label": "OverallScore",
      "section": "PAForms",
      "aliases": [
        "loc:OverallScore",
        "dom:PAForm_OverallScore"
      ],
      "rules": "Optional. Number.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The appraisal's overall score. Calculated, not typed in.</p><p><strong>Example.</strong> 3.60 (KPI A weight 60 rated 4, KPI B weight 40 rated 3)</p><p><strong>Why it matters.</strong> Worked out again whenever a KPI review line is saved or deleted: the appraiser's rating on each line times the line's weight, divided by 100, added up. The employee's self-rating is not used.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
