      ],
      "rules": "Optional. Number.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The final score after moderation, shown on the PA summary and appraisal reports.</p><p><strong>Example.</strong> <code>78</code></p>",
      "adminHtml": "",
