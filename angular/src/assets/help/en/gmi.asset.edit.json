      "label": "Color",
      "section": "Assets",
      "aliases": [
        "loc:Color",
        "dom:Asset_Color"
      ],
      "rules": "Optional. Maximum 64 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The asset's colour.</p><p><strong>Example.</strong> <code>White</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "Asset.VIN_Number",
      "label": "VIN_Number",
      "section": "Assets",
      "aliases": [
        "loc:VIN_Number",
        "dom:Asset_VinNumber"
      ],
      "rules": "Optional. Maximum 64 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The vehicle identification number, for vehicles.</p><p><strong>Example.</strong> <code>JTMHV05J804012345</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "Asset.Serial",
      "label": "Serial",
      "section": "Assets",
      "aliases": [
        "loc:Serial",
        "dom:Asset_Serial"
      ],
      "rules": "Optional. Maximum 64 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The manufacturer's serial number, for equipment.</p><p><strong>Example.</strong> <code>SN-4471902</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "Asset.PlateNumber",
      "label": "PlateNumber",
      "section": "Assets",
      "aliases": [
        "loc:PlateNumber",
        "dom:Asset_PlateNumber"
      ],
      "rules": "Optional. Maximum 64 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The registration plate, for vehicles.</p><p><strong>Example.</strong> <code>12/34567</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "Asset.Barcode",
      "label": "Barcode",
      "section": "Assets",
      "aliases": [
        "loc:Barcode",
        "dom:Asset_Barcode"
      ],
      "rules": "Optional. Maximum 64 characters.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The asset tag or barcode the organisation has fixed to the asset.</p><p><strong>Example.</strong> <code>AST-000312</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "Asset.Year",
      "label": "Year",
      "section": "Assets",
      "aliases": [
        "loc:Year",
        "dom:Asset_Year"
      ],
      "rules": "Optional. Whole number.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The year associated with the asset, typically a vehicle's model year.</p><p><strong>Example.</strong> <code>2022</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "Asset.ExpiryDate",
      "label": "ExpiryDate",
      "section": "Assets",
      "aliases": [
        "loc:ExpiryDate",
        "dom:Asset_ExpiryDate"
      ],
      "rules": "Optional. Date value.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The date something about the asset expires, such as a vehicle's registration or an equipment warranty.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "Asset.Value",
      "label": "Value",
      "section": "Assets",
      "aliases": [
        "loc:Value",
        "dom:Asset_Value"
      ],
      "rules": "Optional. Number.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The asset's value.</p><p><strong>Example.</strong> <code>8500</code></p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "Asset.AssetTypeId",
      "label": "AssetType",
      "section": "Assets",
      "aliases": [
        "loc:AssetType",
        "dom:Asset_AssetTypeId"
      ],
      "rules": "Optional. Chosen from Asset Type master data.",
      "when": null,
      "html": "<p><strong>What it is.</strong> The kind of asset, from the asset types list.</p>",
      "adminHtml": "<p>Asset types are maintained under General Master Info → Asset Types.</p>",
      "stub": false
    },
    {
      "id": "Asset.Status",
      "label": "Status",
      "section": "Assets",
      "aliases": [
        "loc:Status",
        "dom:Asset_Status"
      ],
      "rules": "Required. One of: Active, Inactive.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether the asset is in use.</p><p><strong>Why it matters.</strong> Only active assets are offered when employees request an asset through self-service.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
      "id": "Asset.AssetAllocationStatus",
      "label": "AssetAllocationStatus",
      "section": "Assets",
      "aliases": [
        "loc:AssetAllocationStatus",
        "dom:Asset_AssetAllocationStatus"
      ],
      "rules": "Required. One of: Occupied, Unoccupied.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether the asset is currently issued to someone.</p><p><strong>Why it matters.</strong> Set by hand — issuing the asset to an employee does not change it. It is shown on the asset report.</p>",
      "adminHtml": "",
      "stub": false
    }
  ]
