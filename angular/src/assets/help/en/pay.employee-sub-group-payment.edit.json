    "loc:Amount": "EmployeeSubGroupPayment.Amount",
    "dom:EmployeeSubGroupPayment_Amount": "EmployeeSubGroupPayment.Amount",
    "loc:PayInterval": "EmployeeSubGroupPayment.PayInterval",
    "dom:EmployeeSubGroupPayment_PayInterval": "EmployeeSubGroupPayment.PayInterval",
    "loc:PayMonth": "EmployeeSubGroupPayment.PayMonth",
    "dom:EmployeeSubGroupPayment_PayMonth": "EmployeeSubGroupPayment.PayMonth"
  },
  "fields": [
