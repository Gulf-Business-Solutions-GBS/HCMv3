        "dom:WorkflowSettings_EnableOrgUnitTypeInWorkflow"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether workflow uses organisation unit types.</p><p><strong>Why it matters.</strong> Not read at present — changing it has no effect.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
