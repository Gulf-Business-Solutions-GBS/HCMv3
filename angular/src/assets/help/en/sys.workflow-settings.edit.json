  "fields": [
    {
      "id": "ManageWorkflowSettings.EnableWorkflowGroup",
      "label": "EnableWorkflowGroup",
      "section": null,
      "aliases": [
        "loc:EnableWorkflowGroup",
        "dom:WorkflowSettings_EnableWorkflowGroup"
      ],
      "rules": "Yes or no.",
      "when": null,
      "html": "<p><strong>What it is.</strong> Whether approval chains depend on the employee's workflow group.</p><p><strong>Why it matters.</strong> Ticked, the approval configuration for a request is looked up in the workflow group on the employee's current organisation assignment, falling back to the default group. Unticked, every employee gets the same approval chain for a request type.</p>",
      "adminHtml": "",
      "stub": false
    },
    {
