    "dom:WorkflowSettings_DynamicWorkflowSteps": "ManageWorkflowSettings.DynamicWorkflowSteps",
    "loc:SendBackToCreator": "ManageWorkflowSettings.SendBackToCreator",
    "dom:WorkflowSettings_SendBackToCreator": "ManageWorkflowSettings.SendBackToCreator",
    "loc:DelegateEmployeeListByOrganizationUnitTypeId": "ManageWorkflowSettings.DelegateEmployeeListByOrganizationUnitTypeId",
