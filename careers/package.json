    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/luxon": "^3.7.1",
    "nswag": "^14.6.3",
    "typescript": "5.9.3"
