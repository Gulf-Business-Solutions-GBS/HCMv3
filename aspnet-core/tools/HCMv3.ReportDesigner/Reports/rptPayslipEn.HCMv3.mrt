        <Name>LeaveInfoQuery</Name>
        <NameInSource>db</NameInSource>
        <Parameters isList="true" count="5">
          <value>PrmEmpCode,_x0028_System.String_x002C__x0020_mscorlib_x002C__x0020_Version_x003D_4.0.0.0_x002C__x0020_Culture_x003D_neutral_x002C__x0020_PublicKeyToken_x003D_b77a5c561934e089_x0029__x0028__x005B_PrmEmpCode_x005D__x0029_,12,4000</value>
          <value>PrmMonth,_x0028_System.Int32_x002C__x0020_mscorlib_x002C__x0020_Version_x003D_4.0.0.0_x002C__x0020_Culture_x003D_neutral_x002C__x0020_PublicKeyToken_x003D_b77a5c561934e089_x0029__x0028__x005B_PrmMonth_x005D__x0029_,8,0</value>
          <value>PrmPayrollRunType,_x0028_System.Int32_x002C__x0020_mscorlib_x002C__x0020_Version_x003D_4.0.0.0_x002C__x0020_Culture_x003D_neutral_x002C__x0020_PublicKeyToken_x003D_b77a5c561934e089_x0029__x0028__x005B_PrmPayrollRunType_x005D__x0029_,8,0</value>
          <value>PrmYear,_x0028_System.Int32_x002C__x0020_mscorlib_x002C__x0020_Version_x003D_4.0.0.0_x002C__x0020_Culture_x003D_neutral_x002C__x0020_PublicKeyToken_x003D_b77a5c561934e089_x0029__x0028__x005B_PrmYear_x005D__x0029_,8,0</value>
          <value>TenantId,_x0028_System.Int32_x002C__x0020_mscorlib_x002C__x0020_Version_x003D_4.0.0.0_x002C__x0020_Culture_x003D_neutral_x002C__x0020_PublicKeyToken_x003D_b77a5c561934e089_x0029__x0028__x005B_TenantId_x005D__x0029_,8,0</value>
        </Parameters>
        <SqlCommand>-- rptPayslipEn :: LeaveInfoQuery (srptPayslipLeaveInfo subreport; off-cycle runs only)
-- MECHANICAL rewrite. The "AND @PrmPayrollRunType = 1" guard at the end is legacy's way of making the
-- subreport return nothing on a regular run; kept verbatim rather than moved into report logic.
SELECT
      emp.Code
    , emp.FullNameEn
    , emp.FullNameAr
    , at.NameEn AS AbsenceTypeEn
    , at.NameAr AS AbsenceTypeAr
    , ea.StartDate
    , ea.EndDate
    , ea.StartTime
    , ea.EndTime
    , ea.AbsenceHours
    , ea.TotalLeaveDays
    , ea.CalendarDays
    , ea.PaymentDate
    , ea.ReturnDate
    , CASE ea.LeavePaymentType
        WHEN 0 THEN 'Pay With Payroll'
        WHEN 1 THEN 'Pay In Advance'
        ELSE ''
      END AS LeavePaymentType
FROM EmployeeAbsences ea
LEFT JOIN Employees    emp ON emp.Id = ea.EmployeeId    AND emp.TenantId = @TenantId AND emp.IsDeleted = 0
LEFT JOIN AbsenceTypes at  ON at.Id  = ea.AbsenceTypeId AND at.TenantId  = @TenantId AND at.IsDeleted  = 0
WHERE ea.TenantId = @TenantId AND ea.IsDeleted = 0
  AND ea.LeavePaymentType = 2
  AND emp.Code = @PrmEmpCode
  AND ea.PaymentDate &gt;= DATEFROMPARTS(@PrmYear, @PrmMonth, 1)
  AND ea.PaymentDate &lt;= EOMONTH(DATEFROMPARTS(@PrmYear, @PrmMonth, 1))
  AND @PrmPayrollRunType = 1;
</SqlCommand>
      </LeaveInfoQuery>
