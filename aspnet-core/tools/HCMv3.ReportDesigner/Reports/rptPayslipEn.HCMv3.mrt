        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>071fb9a8736a44c2b0ab11ecaed7fb9c</Key>
        <Name>PayslipDeductionQuery</Name>
        <NameInSource>db</NameInSource>
        <Parameters isList="true" count="5">
          <value>empcode,_x0028_System.String_x002C__x0020_mscorlib_x002C__x0020_Version_x003D_4.0.0.0_x002C__x0020_Culture_x003D_neutral_x002C__x0020_PublicKeyToken_x003D_b77a5c561934e089_x0029__x0028__x005B_empcode_x005D__x0029_,12,4000</value>
          <value>ForPeriod,_x0028_System.DateTime_x002C__x0020_mscorlib_x002C__x0020_Version_x003D_4.0.0.0_x002C__x0020_Culture_x003D_neutral_x002C__x0020_PublicKeyToken_x003D_b77a5c561934e089_x0029__x0028__x005B_ForPeriod_x005D__x0029_,4,0</value>
          <value>InPeriod,_x0028_System.DateTime_x002C__x0020_mscorlib_x002C__x0020_Version_x003D_4.0.0.0_x002C__x0020_Culture_x003D_neutral_x002C__x0020_PublicKeyToken_x003D_b77a5c561934e089_x0029__x0028__x005B_InPeriod_x005D__x0029_,4,0</value>
          <value>RunType,_x0028_System.Int32_x002C__x0020_mscorlib_x002C__x0020_Version_x003D_4.0.0.0_x002C__x0020_Culture_x003D_neutral_x002C__x0020_PublicKeyToken_x003D_b77a5c561934e089_x0029__x0028__x005B_RunType_x005D__x0029_,8,0</value>
          <value>TenantId,_x0028_System.Int32_x002C__x0020_mscorlib_x002C__x0020_Version_x003D_4.0.0.0_x002C__x0020_Culture_x003D_neutral_x002C__x0020_PublicKeyToken_x003D_b77a5c561934e089_x0029__x0028__x005B_TenantId_x005D__x0029_,8,0</value>
        </Parameters>
        <SqlCommand>-- rptPayslipEn :: PayslipDeductionQuery (srptPaySlipDeductionEn subreport -- the deductions block)
--
-- NON-MECHANICAL: legacy carried "SRdetail.WageType &lt;&gt; 65". 65 is a RAW LEGACY PRIMARY KEY, and in
-- HRMS_RCF WageType OID 65 = Code '9000' (Net Pay) -- i.e. the clause means "do not print the net-pay
-- carrier row as a deduction", exactly mirroring the earnings query's "code &lt;&gt; 9000". It is a real
-- rule, not dead legacy noise, and is ported as a Code comparison.
-- (The FastReport pilot in HCMv3.Application/Reports/ReportsAppService.cs dropped this filter on the
-- grounds that 65 had "no stable meaning in HCMv3" -- worth revisiting there.)
SELECT
      emp.Code
    , emp.FullNameEn
    , sr.ForPeriod
    , sr.InPeriod
    , sr.PayrollRunType
    , srd.Amount
    , ROUND(srd.Number, 3)     AS Number
    , ROUND(srd.Rate,   3)     AS Rate
    , wt.NameEn                AS WageType
    , wt.BillingType
    , basicPayCurrency.CurrencyShortFormEn AS Currency
FROM Employees emp
INNER JOIN SalaryRegisters sr
        ON sr.EmployeeId = emp.Id AND sr.TenantId = @TenantId AND sr.IsDeleted = 0
INNER JOIN SalaryRegisterDetails srd
        ON srd.SalaryRegisterId = sr.Id AND srd.TenantId = @TenantId AND srd.IsDeleted = 0
       AND srd.Amount &lt;&gt; 0
INNER JOIN WageTypes wt
        ON wt.Id = srd.WageTypeId AND wt.TenantId = @TenantId AND wt.IsDeleted = 0
       AND wt.BillingType = 1
       AND ISNULL(wt.DontImpactNetPay, 0) = 0
       AND wt.Code &lt;&gt; '9000'
OUTER APPLY (
    SELECT TOP 1 cur.CurrencyShortFormEn
    FROM EmployeeBasicPays ebp
    JOIN EmployeeBasicPayDetails ebpd ON ebpd.EmployeeBasicPayId = ebp.Id AND ebpd.TenantId = @TenantId AND ebpd.IsDeleted = 0
    JOIN WageTypes wtBasic ON wtBasic.Id = ebpd.WageTypeId AND wtBasic.Code = '1000' AND wtBasic.TenantId = @TenantId AND wtBasic.IsDeleted = 0
    LEFT JOIN Currencies cur ON cur.Id = ebpd.CurrencyId AND cur.TenantId = @TenantId AND cur.IsDeleted = 0
    WHERE ebp.EmployeeId = emp.Id AND ebp.TenantId = @TenantId AND ebp.IsDeleted = 0
    ORDER BY ebp.StartDate DESC
) basicPayCurrency
WHERE emp.TenantId = @TenantId AND emp.IsDeleted = 0
  AND emp.Code = @empcode
  AND sr.ForPeriod      = @ForPeriod
  AND sr.InPeriod       = @InPeriod
  AND sr.PayrollRunType = @RunType;
</SqlCommand>
      </PayslipDeductionQuery>
