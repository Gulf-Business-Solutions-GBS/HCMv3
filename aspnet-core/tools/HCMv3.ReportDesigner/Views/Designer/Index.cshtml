@using System
@using Stimulsoft.Report.Mvc
@using System.Collections.Generic
@{
    ViewBag.Title = "HCMv3 Report Designer";
    string selected = ViewBag.SelectedReportFile;
    string defaultFile = ViewBag.DefaultReportFile;
    var otherReports = ViewBag.OtherReports as List<string> ?? new List<string>();
}
<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <meta charset="utf-8" />
    <style>
        html, body { margin: 0; padding: 0; height: 100%; font-family: Segoe UI, Arial, sans-serif; }
        #toolbar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            background: #2d2d30;
            color: #fff;
        }
        #toolbar label { font-size: 13px; }
        #toolbar select {
            font-size: 13px;
            padding: 3px 6px;
            min-width: 420px;
        }
        #toolbar .hint { font-size: 12px; color: #bbb; margin-left: auto; }
        #designerHost { height: calc(100vh - 38px); }
    </style>
</head>
<body>
    <div id="toolbar">
        <label for="reportPicker">Report:</label>
        <select id="reportPicker" onchange="location.href = '@Url.Action("Index")?file=' + encodeURIComponent(this.value)">
            <option value="@defaultFile" selected="@(selected == defaultFile)">@defaultFile (verified payslip)</option>
            @if (otherReports.Count > 0)
            {
                <optgroup label="Auto-converted (unverified) - out/mrt-all">
                    @foreach (var f in otherReports)
                    {
                        <option value="@f" selected="@(selected == f)">@f</option>
                    }
                </optgroup>
            }
        </select>
        <span class="hint">
            @if (otherReports.Count > 0)
            {
                @: @otherReports.Count auto-converted reports found in ReportMigrator/out/mrt-all
            }
            else
            {
                @: out/mrt-all not found - run the ReportMigrator pipeline to populate it
            }
        </span>
    </div>
    <div id="designerHost">
        @Html.StiNetCoreDesigner(new StiNetCoreDesignerOptions()
        {
            Actions =
            {
                GetReport = "GetReport?file=" + Uri.EscapeDataString(selected ?? defaultFile ?? string.Empty),
                DesignerEvent = "DesignerEvent"
            }
        })
    </div>
</body>
</html>
