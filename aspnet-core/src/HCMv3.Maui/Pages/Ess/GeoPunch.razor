@using HCMv3.Maui.Services.Navigation
@using HCMv3.Maui.Core.Helpers
@inherits HCMv3MainLayoutPageComponentBase
@attribute [Route("/" + NavigationUrlConsts.GeoPunch)]

@if (!_loaded)
{
    <div></div>
}
else if (_notLinked)
{
    <div class="card mb-5">
        <div class="card-body">
            <div class="alert alert-warning mb-0">@L("CurrentUserHasNoEmployeeRecord")</div>
        </div>
    </div>
}
else if (_context != null)
{
    @if (!_context.HasDutyPeriodToday)
    {
        <div class="alert alert-warning mb-5">@L("GeoPunchNoDutyWarning")</div>
    }

    <div class="card mb-5">
        <div class="card-body">
            <div class="text-center mb-5">
                <div class="text-muted fs-6">@EssText.Date(_context.ServerTime)</div>
                <div class="fs-2hx fw-bold">@EssText.Time(_context.ServerTime)</div>
            </div>

            <div class="mb-5">
                @if (_context.IsOpenLocation)
                {
                    <div class="alert alert-secondary mb-0">@L("GeoPunchOpenLocation")</div>
                }
                else
                {
                    <label class="form-label required">@L("WorkLocation")</label>
                    <select class="form-select form-select-lg" @bind="_workLocationId">
                        <option value="">@L("GeoPunchSelectWorkLocationOption")</option>
                        @foreach (var location in _context.WorkLocations)
                        {
                            <option value="@location.Id">@WorkLocationName(location)</option>
                        }
                    </select>
                }
            </div>

            @if (_context.RequiresSelfie)
            {
                <div class="text-muted fs-7 mb-4">
                    <i class="fa-solid fa-camera me-2"></i>@L("GeoPunchSelfieRequired")
                </div>
            }

            <div class="d-grid gap-3">
                <button class="btn btn-lg py-5 @(_context.CanClockIn ? "btn-primary" : "btn-secondary")"
                        disabled="@(!_context.CanClockIn || _working)" @onclick="ClockIn">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>@L("GeoPunchClockIn")
                </button>
                <button class="btn btn-lg py-5 @(_context.CanClockOut ? "btn-success" : "btn-secondary")"
                        disabled="@(!_context.CanClockOut || _working)" @onclick="ClockOut">
                    <i class="fa-solid fa-right-from-bracket me-2"></i>@L("GeoPunchClockOut")
                </button>
                @if (_context.IsOvertimeAllowed)
                {
                    <button class="btn btn-lg @(_context.CanOvertimeIn ? "btn-info" : "btn-secondary")"
                            disabled="@(!_context.CanOvertimeIn || _working)" @onclick="OvertimeIn">
                        <i class="fa-solid fa-business-time me-2"></i>@L("GeoPunchOvertimeIn")
                    </button>
                    <button class="btn btn-lg @(_context.CanOvertimeOut ? "btn-info" : "btn-secondary")"
                            disabled="@(!_context.CanOvertimeOut || _working)" @onclick="OvertimeOut">
                        <i class="fa-solid fa-business-time me-2"></i>@L("GeoPunchOvertimeOut")
                    </button>
                }
            </div>

            @if (_working)
            {
                <div class="text-center text-muted mt-4">
                    <i class="fa-solid fa-spinner fa-spin me-2"></i>@L("GeoPunchLocating")
                </div>
            }
        </div>
    </div>

    @if (!_context.HideLocationInfo && _lastCheck != null)
    {
        <div class="card mb-5">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">@L("GeoPunchYourLocation")</span>
                    <span class="badge fs-7 @VerdictCss(_lastCheck.Verdict)">@VerdictLabel(_lastCheck.Verdict)</span>
                </div>
                @if (_lastPosition != null)
                {
                    <div class="fs-7 mb-2">
                        @(_lastPosition.Latitude.ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture)),
                        @(_lastPosition.Longitude.ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture))
                    </div>
                }
                @if (SelectedWorkLocation != null)
                {
                    <div class="fs-7 text-muted mb-2">@L("WorkLocation"): @WorkLocationName(SelectedWorkLocation)</div>
                }
                <div class="fs-7">@DistanceText(_lastCheck)</div>
            </div>
        </div>
    }

    @if (!_context.HidePunchList)
    {
        <div class="card mb-5">
            <div class="card-header min-h-50px d-flex align-items-center justify-content-between">
                <h3 class="card-title fs-5">@L("GeoPunchTodaysPunches")</h3>
                <button class="btn btn-sm btn-icon btn-light" @onclick="ReloadAsync" title="@L("Refresh")">
                    <i class="fa-solid fa-rotate"></i>
                </button>
            </div>
            <div class="card-body p-3">
                @if (_context.TodaysPunches == null || _context.TodaysPunches.Count == 0)
                {
                    <p class="text-muted mb-0">@L("GeoPunchNoPunchesToday")</p>
                }
                else
                {
                    @foreach (var punch in _context.TodaysPunches)
                    {
                        <div class="border-bottom py-3 d-flex justify-content-between align-items-center">
                            <div class="min-w-0 me-2">
                                <div class="fw-bold text-gray-800">@PunchTypeName(punch)</div>
                                @if (!string.IsNullOrWhiteSpace(PunchWorkLocationName(punch)))
                                {
                                    <div class="text-muted fs-7">@PunchWorkLocationName(punch)</div>
                                }
                            </div>
                            <div class="text-end">
                                <div class="fw-bold">@EssText.Time(punch.TransTime)</div>
                                @if (!string.IsNullOrWhiteSpace(punch.WorkLocationNameEn))
                                {
                                    @if (punch.PunchInRange)
                                    {
                                        <span class="badge badge-light-success">@L("GeoPunchInRange")</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">@L("GeoPunchOutOfRange") (+@(EssText.Number(Math.Round(punch.RangeDifference))) m)</span>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
}
